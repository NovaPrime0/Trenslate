# Test program covering all valid tokens in Trenslate
# Tests keywords, identifiers, constants, operators, comments, and delimiters

# Imports
daan "istasyon.h";
daan "sistema_tren.h";

# Function definition and math operators: +, -, *, /, //, **, %
/* Calculates fare based on distance and passenger count */
route kwentaPamasahe(distansya, pasaheroCount) {
    bagahe basePamasahe = 15;
    bagahe bawasDistansya = distansya - 5;
    bagahe dagdagBayad = bawasDistansya * 2;
    bagahe kabuuan = basePamasahe + dagdagBayad;
    
    # Integer division and modulo
    bagahe grupoPares = pasaheroCount // 2;
    bagahe sobraPasahero = pasaheroCount % 2;
    
    # Exponentiation and division
    bagahe antasKuryente = 2 ** 3;
    bagahe hatiRate = kabuuan / 2;
    
    # Conditionals with relational and logical operators
    sakali (distansya >= 10 && pasaheroCount > 1) {
        kabuuan = kabuuan + 5;
    } liko sakali (distansya <= 4 || pasaheroCount == 0) {
        kabuuan = basePamasahe;
    } liko {
        kabuuan = kabuuan;
    }
    
    # Return statement
    baba kabuuan;
}

# Main program entry
byahe {
    # Constants
    laging MAX_KAPASIDAD = 500;
    laging MIN_PAMASAHE = 15;
    laging PANGALAN_TREN = "LRT-Line-1";
    laging KODIGO_ESTASYON = 'L';
    
    # Variables with different literal types
    bagahe kasalukuyangPasahero = 120;             # integer
    bagahe porsyentoPuno = 24.50;                   # decimal
    bagahe mensaheBati = "Maligayang Pagsakay!";   # string
    bagahe klaseTicket = 'A';                      # char
    bagahe mayDiskwento = TRUE;                    # boolean true
    bagahe punoNaBa = FALSE;                       # boolean false
    bagahe reserbangUpuan = exit;                  # null value
    
    # Printing with noise word 'ng'
    announce ng mensaheBati;
    
    # Checking status with logical NOT (!)
    bagahe katayuan = "bukas";
    sakali (kasalukuyangPasahero != MAX_KAPASIDAD && !punoNaBa) {
        katayuan = "Tumatanggap pa ng pasahero";
    }
    
    # For loop using 'mula' and 'hanggang'
    hakbang index mula 1 hanggang 5 {
        sakali (index == 3) {
            tuloy; # continue to next iteration
        }
    }
    
    # Foreach loop using 'bawat' and 'sa'
    bagahe rutaListahan = [1, 2, 3, 4, 5];
    bawat ruta sa rutaListahan {
        sakali (ruta > 4) {
            hinto; # break loop
        }
    }
    
    # While loop using 'habang'
    bagahe metroKomersyal = 0;
    habang (metroKomersyal < 3) {
        metroKomersyal = metroKomersyal + 1;
        sakali (metroKomersyal == 2) {
            hinto; # stop loop
        }
    }
    
    # Function call and output
    bagahe resultaHalaga = kwentaPamasahe(12, 3);
    announce ng "Kabuuang bayad sa biyahe!";
    announce(resultaHalaga);
    
    # End of program
    dulo;
}
