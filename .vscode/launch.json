{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Trenslate (F5)",
      "type": "cppdbg",
      "request": "launch",
      "args": ["sample.tren"],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/main.exe",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}